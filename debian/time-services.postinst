#!/bin/sh
set -e

if [ "$1" = configure ] && [ -z "${DPKG_ROOT:-}" ] &&
   [ -d /run/udev ] && command -v udevadm >/dev/null 2>&1; then
    # The group must exist before udev applies the rule. Debhelper repeats
    # this idempotent operation below, before enabling/starting the service.
    systemd-sysusers time-services.conf
    if udevadm control --reload; then
        udevadm trigger --action=change --subsystem-match=rtc \
            --sysname-match=rtc0 --settle || true
    fi
fi

#DEBHELPER#
