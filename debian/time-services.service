[Unit]
Description=time serviced Service

[Service]
User=_qcom-time
Group=_qcom-time
StateDirectory=time
Restart=on-failure
CapabilityBoundingSet=CAP_SYS_TIME
AmbientCapabilities=CAP_SYS_TIME
ExecStart=/usr/sbin/time_daemon

# Device access for RTC (read-only)
DeviceAllow=/dev/rtc0 r
DevicePolicy=closed

[Install]
WantedBy=multi-user.target
